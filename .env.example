# Copy to .env for local work. Nothing in here is committed — .env is ignored.

# --- required in production -------------------------------------------------
# openssl rand -hex 32   (or: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=
# Neon's POOLED connection string — the host with "-pooler" in it. The direct
# one will exhaust connections on serverless. Defaults to local SQLite if unset.
DATABASE_URL=
# public origin, used in emails and pairing links
BASE_URL=http://127.0.0.1:5000

# --- optional: sign-in providers (both free) --------------------------------
# console.cloud.google.com -> Credentials -> OAuth client ID (Web application)
# redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# discord.com/developers -> New Application -> OAuth2
# redirect URI: <BASE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- optional: outbound email -----------------------------------------------
# Leave unset and verification links are printed to the log instead, which is
# all you need to develop signup. For real mail, a Gmail app password works and
# needs no domain: myaccount.google.com -> Security -> App passwords.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- the MusicBrainz resolver -------------------------------------------------
# Shared secret for POST /v1/internal/resolve. The GitHub Actions cron in
# .github/workflows/resolve.yml sends it as a bearer token; set the same value
# as a repo secret there. Unset means nobody can call it, not everybody.
RESOLVER_TOKEN=
# MusicBrainz asks that the User-Agent identifies you contactably. Being rude
# here gets the project blocked, not just one request.
MUSICBRAINZ_CONTACT=https://github.com/<you>/noskips

# --- moderation ---------------------------------------------------------------
# Comma-separated handles that can reach /admin. Set this before inviting
# anyone: the report queue exists but is useless if nobody can open it.
ADMIN_HANDLES=
# The kill switch. Set to 1 to stop every write while leaving the site readable.
NOSKIPS_READ_ONLY=
# Where /discord redirects to, so the invite can rotate without breaking links.
DISCORD_INVITE=

# --- the website --------------------------------------------------------------
# Where the download buttons and the footer point. The repo is being renamed
# from rateify to noskips, and the release links 404 until this matches the
# real one. Defaults to kaanisthatyou/noskips.
GITHUB_REPO=

# --- the widget ---------------------------------------------------------------
# Which server the desktop widget talks to. It defaults to
# https://noskips.vercel.app, which does not exist until you deploy — point this
# at your own deployment, or at http://127.0.0.1:5000 while developing.
NOSKIPS_SERVER=
